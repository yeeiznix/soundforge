{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soundforge.pa/schemas/project_v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "engineVersion",
    "project",
    "venue",
    "scene",
    "audienceReceivers",
    "equipment",
    "signalGraph",
    "powerGraph",
    "audioAssets",
    "dspPresets",
    "arrayConfigurations",
    "measurements",
    "simulationRuns",
    "trainingScenarios",
    "inventoryRefs",
    "reports",
    "auditLog"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "engineVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+.*$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "createdAt", "modifiedAt", "author", "notes"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "modifiedAt": { "type": "string", "format": "date-time" },
        "author": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "venue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "dimensions"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["widthM", "depthM", "heightM"],
          "properties": {
            "widthM": { "type": "number", "exclusiveMinimum": 0 },
            "depthM": { "type": "number", "exclusiveMinimum": 0 },
            "heightM": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "venueRef", "geometry"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "venueRef": { "type": "string", "format": "uuid" },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["center", "listening"],
          "properties": {
            "center": { "$ref": "#/$defs/point3" },
            "listening": { "$ref": "#/$defs/point3" }
          }
        }
      }
    },
    "audienceReceivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/objectEnvelope" }
    },
    "equipment": {
      "type": "array",
      "items": { "$ref": "#/$defs/objectEnvelope" }
    },
    "signalGraph": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/signalNode" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/signalEdge" }
        },
        "mixers": {
          "type": "array",
          "items": { "$ref": "#/$defs/signalMixerState" }
        }
      }
    },
    "powerGraph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": { "type": "array" },
        "edges": { "type": "array" }
      }
    },
    "audioAssets": {
      "type": "array",
      "items": { "$ref": "#/$defs/objectEnvelope" }
    },
    "dspPresets": {
      "type": "array",
      "items": { "$ref": "#/$defs/objectEnvelope" }
    },
    "arrayConfigurations": {
      "type": "array",
      "items": { "$ref": "#/$defs/objectEnvelope" }
    },
    "measurements": {
      "type": "array",
      "items": { "$ref": "#/$defs/objectEnvelope" }
    },
    "simulationRuns": {
      "type": "array",
      "items": { "$ref": "#/$defs/objectEnvelope" }
    },
    "trainingScenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/objectEnvelope" }
    },
    "inventoryRefs": {
      "type": "array",
      "items": { "$ref": "#/$defs/objectEnvelope" }
    },
    "reports": {
      "type": "array",
      "items": { "$ref": "#/$defs/objectEnvelope" }
    },
    "auditLog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ts", "actor", "action", "objectId", "detail"],
        "properties": {
          "ts": { "type": "string", "format": "date-time" },
          "actor": { "type": "string" },
          "action": {
            "type": "string",
            "enum": [
              "project.create",
              "project.open",
              "project.save",
              "project.migrate",
              "project.rename",
              "venue.update",
              "scene.update",
              "graph.addNode",
              "graph.removeNode",
              "graph.addEdge",
              "graph.removeEdge",
              "graph.setMixer",
              "graph.setPreset"
            ]
          },
          "objectId": { "type": "string", "format": "uuid" },
          "detail": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "point2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "signalNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "label", "position", "mixer"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["source", "processor", "output", "bus"]
        },
        "id": { "type": "string", "format": "uuid" },
        "label": { "type": "string" },
        "position": { "$ref": "#/$defs/point2" },
        "mixer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mute", "solo"],
          "properties": {
            "mute": { "type": "boolean" },
            "solo": { "type": "boolean" },
            "gainDb": { "type": "number" },
            "pan": { "type": "number" }
          }
        }
      }
    },
    "signalEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "label"],
      "properties": {
        "from": { "type": "string", "format": "uuid" },
        "to": { "type": "string", "format": "uuid" },
        "label": { "type": "string" },
        "id": { "type": "string", "format": "uuid" }
      }
    },
    "signalMixerState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "gains", "mute", "solo"],
      "properties": {
        "nodeId": { "type": "string", "format": "uuid" },
        "gains": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "mute": { "type": "boolean" },
        "solo": { "type": "boolean" }
      }
    },
    "point3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "objectEnvelope": {
      "type": "object",
      "required": ["id", "type", "version", "createdAt", "modifiedAt", "provenance", "data"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "type": {
          "type": "string",
          "enum": [
            "audienceReceiver",
            "equipment",
            "audioAsset",
            "dspPreset",
            "arrayConfiguration",
            "measurement",
            "simulationRun",
            "trainingScenario",
            "inventoryRef",
            "report",
            "signalGraph",
            "powerGraph"
          ]
        },
        "version": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "modifiedAt": { "type": "string", "format": "date-time" },
        "provenance": { "type": "string" },
        "data": { "type": "object" }
      }
    }
  }
}
